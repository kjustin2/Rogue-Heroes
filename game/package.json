{
  "name": "rogue-heroes-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview",
    "smoke:flow": "node scripts/smoke-flow.mjs",
    "smoke:economy": "node scripts/smoke-economy.mjs",
    "smoke:buttons": "node scripts/smoke-buttons.mjs",
    "smoke:deep": "node scripts/smoke-deep.mjs",
    "smoke:ui-audit": "node scripts/smoke-ui-audit.mjs",
    "smoke:ground": "node scripts/smoke-ground.mjs",
    "screens": "node scripts/polish-screens.mjs",
    "improve:capture": "node improve/capture-flow.mjs",
    "improve:check": "node improve/check-goals.mjs",
    "improve:cycle": "node improve/run-cycle.mjs",
    "improve:gallery": "node improve/scenario-gallery.mjs",
    "perf": "node improve/perf-bench.mjs",
    "perf:profile": "node scripts/perf-profile.mjs",
    "perf:census": "node scripts/perf-census.mjs",
    "audit:unit": "node scripts/probe-unit.mjs",
    "probe:shadow": "node scripts/probe-shadow.mjs",
    "probe:ground": "node scripts/probe-ground.mjs",
    "probe:depth": "node scripts/probe-depth.mjs",
    "shots:look": "node scripts/shot-look.mjs",
    "shots:filmstrip": "node scripts/shot-filmstrip.mjs",
    "shots:gas": "node scripts/shot-gas.mjs",
    "shots:damage": "node scripts/shot-damage.mjs",
    "vision": "node improve/vision.mjs",
    "smoke:electron": "electron scripts/smoke-electron.cjs",
    "test:play": "npm run build && npm run smoke:electron",
    "smoke:faction": "node scripts/shot-faction.mjs",
    "smoke:animation": "node scripts/shot-animation.mjs",
    "smoke:director": "node scripts/shot-director.mjs",
    "shots:portraits": "node scripts/shot-portraits.mjs",
    "shots:silhouette": "node scripts/shot-silhouette.mjs",
    "art:motion": "blender --background --python art/infantry/author_motion.py",
    "art:kit": "blender --background --python art/infantry/author_kit.py",
    "art:motion:export": "blender --background --python art/infantry/author_motion.py -- --export-existing",
    "smoke:core": "npm run smoke:buttons && npm run smoke:flow && npm run smoke:economy && npm run smoke:deep && npm run smoke:ground && npm run smoke:ui-audit && npm run smoke:faction && npm run smoke:animation && npm run smoke:director",
    "test:full": "npm run verify && npm run smoke:core",
    "desktop": "electron .",
    "standalone": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --win portable"
  },
  "author": "Rogue Heroes",
  "build": {
    "appId": "com.rogueheroes.tactical",
    "productName": "Rogue Heroes Tactics",
    "files": [
      "electron-main.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "postprocessing": "^6.39.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.0",
    "@types/three": "^0.170.0",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
