{
  "name": "rogue-heroes-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:scripts && npm test && npm run build",
    "preview": "vite preview",
    "smoke:flow": "node scripts/smoke-flow.mjs",
    "smoke:economy": "node scripts/smoke-economy.mjs",
    "smoke:buttons": "node scripts/smoke-buttons.mjs",
    "smoke:deep": "node scripts/smoke-deep.mjs",
    "smoke:ui-audit": "node scripts/smoke-ui-audit.mjs",
    "smoke:hotseat": "node scripts/smoke-hotseat.mjs",
    "smoke:ground": "node scripts/smoke-ground.mjs",
    "screens": "node scripts/polish-screens.mjs",
    "improve:gallery": "node improve/scenario-gallery.mjs",
    "perf": "node improve/perf-bench.mjs",
    "perf:profile": "node scripts/perf-profile.mjs",
    "perf:census": "node scripts/perf-census.mjs",
    "audit:unit": "node scripts/probe-unit.mjs",
    "probe:shadow": "node scripts/probe-shadow.mjs",
    "probe:ground": "node scripts/probe-ground.mjs",
    "probe:depth": "node scripts/probe-depth.mjs",
    "probe:terrain": "node scripts/probe-terrain.mjs",
    "probe:intro": "npm run build && electron scripts/probe-intro.cjs",
    "glitch:sweep": "electron scripts/glitch-sweep.cjs",
    "glitch:probe": "electron scripts/glitch-probe.cjs",
    "glitch:crop": "node scripts/glitch-crop.cjs",
    "shot:probe": "electron scripts/shot-probe.cjs",
    "verify:persist": "electron scripts/verify-persist.cjs write && electron scripts/verify-persist.cjs read",
    "verify:autosave": "node scripts/verify-autosave.mjs",
    "shots:look": "node scripts/shot-look.mjs",
    "shots:props": "node scripts/shot-props.mjs",
    "shots:filmstrip": "node scripts/shot-filmstrip.mjs",
    "shots:gas": "node scripts/shot-gas.mjs",
    "shots:damage": "node scripts/shot-damage.mjs",
    "balance:factions": "vite-node src/game/factionMatchup.selfplay.ts",
    "shots:factions": "node scripts/shot-factions.mjs",
    "shots:lineup": "node scripts/shot-lineup.mjs",
    "vision": "node improve/vision.mjs",
    "smoke:electron": "electron scripts/smoke-electron.cjs",
    "soak:gpu": "electron scripts/soak-gpu.cjs",
    "shots:gpu": "electron scripts/shots-gpu.cjs",
    "test:play": "npm run build && npm run smoke:electron",
    "smoke:faction": "node scripts/shot-faction.mjs",
    "smoke:animation": "node scripts/shot-animation.mjs",
    "smoke:attacks": "node scripts/smoke-attacks.mjs",
    "smoke:director": "node scripts/shot-director.mjs",
    "shots:portraits": "node scripts/shot-portraits.mjs",
    "shots:silhouette": "node scripts/shot-silhouette.mjs",
    "art:motion": "node scripts/blender.mjs art/infantry/author_motion.py",
    "art:kit": "node scripts/blender.mjs art/infantry/author_kit.py",
    "art:motion:export": "node scripts/blender.mjs art/infantry/author_motion.py -- --export-existing",
    "art:props": "node scripts/blender.mjs art/props/author_props.py",
    "art:validate:selftest": "node scripts/blender.mjs art/infantry/validate_selftest.py",
    "art:inspect": "node scripts/inspect-glb.mjs",
    "probe:map": "node scripts/probe-map.mjs",
    "shots:diff": "node scripts/shot-diff.mjs",
    "smoke:core": "npm run smoke:buttons && npm run smoke:flow && npm run smoke:economy && npm run smoke:deep && npm run smoke:ground && npm run smoke:ui-audit && npm run smoke:faction && npm run smoke:animation && npm run smoke:attacks && npm run smoke:director && npm run smoke:hotseat",
    "test:full": "npm run verify && npm run smoke:core",
    "desktop": "electron .",
    "standalone": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --win portable",
    "shots:step": "node scripts/shot-step.mjs",
    "art:vehicles": "node scripts/blender.mjs art/vehicles/author_vehicles.py",
    "check:scripts": "node scripts/check-scripts.mjs"
  },
  "author": "Rogue Heroes",
  "build": {
    "appId": "com.rogueheroes.tactical",
    "productName": "Rogue Heroes Tactics",
    "files": [
      "electron-main.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "postprocessing": "^6.39.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.0",
    "@types/three": "^0.170.0",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
